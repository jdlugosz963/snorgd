# Copy to snorgd.env, fill in, and `source snorgd.env` before running snorgd
# (or point a systemd EnvironmentFile / compose env_file at it).
# Keep the real file out of git (see .gitignore).

# --- Dropbox app (https://www.dropbox.com/developers/apps), all required ---
export DROPBOX_APP_KEY=
export DROPBOX_APP_SECRET=
export DROPBOX_REFRESH_TOKEN=

# Folder to watch, recursively. Required — set "/" to watch the whole Dropbox.
export DROPBOX_FOLDER=/Supernote

# --- Archive (local clone of the notes repo), required ---
export SNORGD_ARCHIVE="$HOME/notes-snorg"
# Git remote used to clone SNORGD_ARCHIVE if it does not exist yet. Required.
export SNORGD_REMOTE=git@example.com:you/notes-snorg

# Optional: where the Dropbox cursor is persisted (defaults to
# $XDG_STATE_HOME/snorgd, i.e. ~/.local/state/snorgd).
# export SNORGD_STATE_DIR="$HOME/.local/state/snorgd"

# Optional: committer identity for archive commits (defaults shown).
# export SNORGD_GIT_NAME=snorgd
# export SNORGD_GIT_EMAIL=snorgd@localhost

# --- Container example (docker compose) -----------------------------------
# When running via compose.yaml, point the paths at the mounted volumes:
# export SNORGD_ARCHIVE=/data/archive
# export SNORGD_STATE_DIR=/data/state
